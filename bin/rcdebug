#!/usr/bin/env python3
"""
Global executable wrapper for rcdebug (Revan Cool Debugger).
"""

import sys
from pathlib import Path

# Ensure the package root is importable regardless of where the symlink/script is invoked from
PACKAGE_ROOT = Path("/Users/revanveroka/Music/rcdebug").resolve()
if str(PACKAGE_ROOT) not in sys.path:
    sys.path.insert(0, str(PACKAGE_ROOT))

from rcdebug.cli import main

if __name__ == "__main__":
    sys.exit(main())
